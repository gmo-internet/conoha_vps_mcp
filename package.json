{
	"name": "@gmo-internet/conoha-vps-mcp",
	"version": "0.6.1",
	"description": "日本語対応のConoHa VPS Model Context Protocol (MCP) サーバー",
	"author": "GMO Internet",
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"conoha-vps-mcp": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"keywords": [
		"conoha",
		"vps",
		"mcp",
		"modelcontextprotocol",
		"openstack"
	],
	"homepage": "https://github.com/gmo-internet/conoha_vps_mcp",
	"bugs": {
		"url": "https://github.com/gmo-internet/conoha_vps_mcp/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gmo-internet/conoha_vps_mcp.git"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"NOTICE"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "vite build --config vite.config.server.ts && vite build",
		"build:server": "vite build --config vite.config.server.ts",
		"build:ui": "vite build",
		"build:types": "tsc --emitDeclarationOnly",
		"build:mcpb": "mcpb pack",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"preview:ui": "vite --config vite.config.preview.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
		"typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
		"biome:ci": "biome ci .",
		"biome:fix": "biome check --write .",
		"test": "vitest run --coverage",
		"generate:notice": "node scripts/generate-notice.js",
		"inspector": "npx @modelcontextprotocol/inspector",
		"docs:build": "typedoc",
		"docs:watch": "typedoc --watch",
		"docs:serve": "npx serve reports/docs",
		"audit:ci": "npm audit --audit-level=high --omit=dev",
		"knip": "knip",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs",
		"jscpd": "jscpd src/"
	},
	"dependencies": {
		"@modelcontextprotocol/ext-apps": "^1.7.5",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@anthropic-ai/mcpb": "2.1.2",
		"@biomejs/biome": "2.5.13",
		"@types/node": "^22.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "5.0.0",
		"dependency-cruiser": "18.3.0",
		"jscpd": "5.2.0",
		"knip": "6.35.1",
		"tsx": "4.23.13",
		"typedoc": "0.28.20",
		"typescript": "6.0.3",
		"vite": "8.3.0",
		"vite-plugin-singlefile": "2.3.3",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "5.0.0"
	},
	"overrides": {
		"qs": "^6.15.3",
		"@inquirer/prompts": "^8.5.2",
		"js-yaml": "^4.3.2"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
