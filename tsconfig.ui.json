{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": [
			"vite/client",
			"vite-plugin-svgr/client"
		]
	},
	"include": [
		"src/apps/ui/**/*"
	]
}
